# Скопируйте в .dev.vars и замените код на свой. Файл .dev.vars не публикуется.
APP_ORIGIN=http://127.0.0.1:5173
ENVIRONMENT=development
DEMO_DATA=true
SETUP_TOKEN=change-me-local-setup-token

# Опционально: ключи баннера Turnstile для локальной разработки.
# При работе с реальным доменом используйте sitekey, привязанный к вашему домену.
# Для локальной разработки можно использовать публичный тестовый sitekey, но тогда
# серверная проверка (островной) не пропустит токен — на локальной машине форму
# можно проверять через сетевой запрос в обход Turnstile:
#   curl -X POST http://127.0.0.1:8787/api/feedback -H 'Content-Type: application/json' \
#     -d '{"name":"Иван Иванов","contact":"+375330000000","topic":"general","message":"Привет","consent":true,"started_at":0}'
# Этого достаточно, чтобы убедиться, что сохраняется в БД.

TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
